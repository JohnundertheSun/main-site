# Copy to .env.local for local development. Never commit .env.local.
# In production these live in Vercel: Project, Settings, Environment Variables.

# --- Supabase ---------------------------------------------------------------
# Project URL, from Project Settings, API.
SUPABASE_URL=https://jtubwqcrqvlpbscsoraz.supabase.co

# The SECRET key (sb_secret_..., or a legacy service_role JWT).
# Server-only, never exposed to the browser. Not the sb_publishable_... key,
# which RLS will reject.
SUPABASE_SERVICE_ROLE_KEY=

# --- Admin ------------------------------------------------------------------
# Gates /admin/*. Pick your own, unrelated to Supabase.
ADMIN_PASSWORD=

# --- Resend -----------------------------------------------------------------
# From resend.com, API Keys. Leave blank locally to skip sending email:
# forms still save to Supabase, nothing is sent.
RESEND_API_KEY=

# Sender. Must be on a domain verified in Resend.
EMAIL_FROM="Jayburtt Dijkhoff <hello@updates.jayburttdijkhoff.com>"

# Where new signup notifications go. Comma-separated for more than one.
EMAIL_TO_ADMIN=

# Where a visitor's reply should land. Defaults to the first EMAIL_TO_ADMIN.
EMAIL_REPLY_TO=

# --- Site -------------------------------------------------------------------
# Only needed on preview deploys, so shared links point at the preview.
# NEXT_PUBLIC_SITE_URL=
